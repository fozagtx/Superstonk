# Required — Postgres for users, plans, activity, price snapshots
DATABASE_URL=

# Required — bearer secret for /api/snapshot and /api/cron/run-buys
CRON_SECRET=

# Required — absolute app URL (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=

# Clawpump — a cpk_ key from https://clawpump.tech/dashboard/api.
# Without it the app runs in demo mode (simulated agent, simulated buys).
CLAWPUMP_API_KEY=
# Only needed to point at a non-default Clawpump API deployment.
CLAWPUMP_API_URL=

# Privy — from the Privy dashboard. Without it the app runs in demo mode
# (single shared demo user, no sign-in).
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Solana RPC for the Privy wallet (use a paid provider on mainnet)
NEXT_PUBLIC_SOLANA_RPC_URL=

# Agent token pool — set after the Meteora DBC launch so the /agent page
# can show the live pool.
AGENT_TOKEN_MINT=
METEORA_POOL_ADDRESS=
METEORA_DBC_CONFIG=
